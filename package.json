{
  "name": "mail-system",
  "version": "1.0.0",
  "description": "Mail System Desktop Panel",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "admin": "node server/license-server.cjs",
    "build": "vite build",
    "test": "node --test tests/*.test.cjs",
    "start": "electron .",
    "package:mac": "npm run build && electron-builder --mac dmg --publish never",
    "package:mac:zip": "npm run build && electron-builder --mac zip --publish never",
    "package:mac:dir": "npm run build && electron-builder --mac dir --publish never",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "package:win:portable": "npm run build && electron-builder --win portable --publish never",
    "package:win:dir": "npm run build && electron-builder --win dir --publish never"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.46.0",
    "pg": "^8.23.0",
    "pptxgenjs": "^4.0.1",
    "puppeteer-core": "^25.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.mailsystem.desktop",
    "productName": "Mail System",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Mail-System-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Mail-System-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mail System"
    }
  }
}
