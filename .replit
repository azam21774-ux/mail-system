modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run admin"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 5000


[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 24974
externalPort = 80

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
GOOGLE_OAUTH_CLIENT_ID = "882522"
